]
all_products = (
    storage_products
    + appliance_products
    + furniture_products
    + home_decor_products
    + cookware_products
)
categories = (
    ["Storage & Organizers"] * len(storage_products)
    + ["Appliances"] * len(appliance_products)
    + ["Furniture"] * len(furniture_products)
    + ["Home Decor"] * len(home_decor_products)
    + ["Cookware & Tableware"] * len(cookware_products)
)

sku_ids = []

for i in range(1, len(all_products) + 1):
    sku_ids.append(f"SKU{i:03d}")

sku_master = pd.DataFrame({
    "sku_id": sku_ids,
    "product_name": all_products,
    "category": categories
})    
price_ranges = {
    "Storage & Organizers": (100, 800),
    "Appliances": (800, 35000),
    "Furniture": (1500, 40000),
    "Home Decor": (100, 3000),
    "Cookware & Tableware": (150, 3000)
}
unit_costs = []

for category in sku_master["category"]:
    min_cost, max_cost = price_ranges[category]
    cost = random.randint(min_cost, max_cost)
    unit_costs.append(cost)

sku_master["unit_cost"] = unit_costs

list_prices = []

for cost in sku_master["unit_cost"]:
    markup = random.uniform(0.20, 0.60)
    price = round(cost * (1 + markup))
    list_prices.append(price)

sku_master["list_price"] = list_prices

start_date = pd.Timestamp("2021-01-01")
end_date = pd.Timestamp("2025-12-31")

launch_dates = [
    start_date + pd.Timedelta(
        days=random.randint(0, (end_date - start_date).days)
    )
    for _ in range(len(sku_master))
]
sku_master["launch_date"] = launch_dates


sku_master.to_csv(
    "data/processed/sku_master.csv",
    index=False
)

print("SKU Master saved successfully.")